---
import { getCollection, render } from 'astro:content';
import PolicyLayout from '@/layouts/PolicyLayout.astro';

export async function getStaticPaths() {
  const allPolicies = await getCollection('policies');

  return allPolicies.flatMap((entry) => {
    if (entry.data.draft && import.meta.env.PROD) return [];
    const [locale, documentName] = entry.id.split('/');
    const match = documentName?.match(/^(.+)-(privacy|terms)$/);
    if (!locale || !match) return [];

    const [, app, policy] = match;
    return [{
      params: { locale, app, policy },
      props: { entry },
    }];
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PolicyLayout
  title={entry.data.title}
  app={entry.data.app}
  lastUpdated={entry.data.lastUpdated}
  lastUpdatedLabel={entry.data.lastUpdatedLabel}
  contentLanguage={entry.data.contentLanguage}
>
  <Content />
</PolicyLayout>
